{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/contatti",
	"title": "Contatti",
	"description": "Elenco dei recapiti (dai dati del footer) e modulo di contatto.",
	"category": "starter",
	"icon": "phone",
	"keywords": [
		"contatti",
		"form",
		"recapiti"
	],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [
			"full"
		],
		"anchor": true,
		"customClassName": true,
		"html": false
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
