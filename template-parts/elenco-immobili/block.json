{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/elenco-immobili",
	"title": "Immobili — Elenco",
	"description": "Tutti gli immobili con filtri (GET, senza AJAX), 9 per pagina con paginazione.",
	"category": "starter",
	"icon": "list-view",
	"keywords": [
		"immobili",
		"elenco",
		"filtri"
	],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [
			"full"
		],
		"anchor": true,
		"customClassName": true
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
