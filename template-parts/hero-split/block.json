{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/hero-split",
	"title": "Hero testo + foto",
	"description": "Prima sezione della pagina: occhiello, titolo, testo, due pulsanti e una foto a lato.",
	"category": "starter",
	"icon": "cover-image",
	"keywords": [
		"hero",
		"testo",
		"foto",
		"home"
	],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [
			"full"
		],
		"anchor": true,
		"customClassName": true,
		"html": false
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
