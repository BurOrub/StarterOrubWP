{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/hero-video",
	"title": "Hero con video",
	"description": "Video a tutta larghezza (muto, in ciclo) con velo scuro, titolo, testo e pulsante: alternativa alla hero con slider.",
	"category": "starter",
	"icon": "video-alt3",
	"keywords": [
		"hero",
		"video",
		"copertina",
		"cover"
	],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [
			"full"
		],
		"anchor": true,
		"customClassName": true,
		"html": false
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}