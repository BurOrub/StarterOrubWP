{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/intestazione-pagina",
	"title": "Intestazione pagina",
	"description": "Occhiello, titolo H1 e paragrafo in cima alla pagina, con briciole di pane.",
	"category": "starter",
	"icon": "heading",
	"keywords": [ "intestazione", "titolo", "h1" ],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [ "full" ],
		"anchor": true,
		"customClassName": true
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
