{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/mappa",
	"title": "Mappa",
	"description": "Mappa Google a tutta larghezza con pulsante per le indicazioni.",
	"category": "starter",
	"icon": "location",
	"keywords": [ "mappa", "indicazioni" ],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [ "full" ],
		"anchor": true,
		"customClassName": true
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
