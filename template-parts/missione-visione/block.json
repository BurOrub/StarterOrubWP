{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/missione-visione",
	"title": "Due riquadri",
	"description": "Due (o più) riquadri affiancati su sfondo chiaro; il secondo evidenziato con il colore d'accento.",
	"category": "starter",
	"icon": "columns",
	"keywords": [ "missione", "visione", "riquadri" ],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [ "full" ],
		"anchor": true,
		"customClassName": true
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
