{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/prodotti-in-evidenza",
	"title": "Prodotti in evidenza",
	"description": "Griglia di prodotti WooCommerce con la card del negozio.",
	"category": "starter",
	"icon": "cart",
	"keywords": [
		"prodotti",
		"shop",
		"woocommerce"
	],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [
			"full"
		],
		"anchor": true,
		"customClassName": true,
		"html": false
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
