{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/progetti",
	"title": "Elenco progetti",
	"description": "Griglia dei progetti del portfolio con le schede delle categorie: mettila in una pagina (es. Portfolio).",
	"category": "starter",
	"icon": "screenoptions",
	"keywords": [
		"progetto",
		"portfolio",
		"elenco",
		"griglia"
	],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [
			"full"
		],
		"anchor": true,
		"customClassName": true,
		"html": false
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
