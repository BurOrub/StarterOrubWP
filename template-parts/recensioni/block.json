{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/recensioni",
	"title": "Recensioni",
	"description": "Carosello di recensioni con 5 stelle, scorrevole con le frecce.",
	"category": "starter",
	"icon": "format-quote",
	"keywords": [ "recensioni", "testimonianze" ],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [ "full" ],
		"anchor": true,
		"customClassName": true
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
