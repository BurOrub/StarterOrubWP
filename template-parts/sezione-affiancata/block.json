{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/sezione-affiancata",
	"title": "Sezione affiancata",
	"description": "Foto (1 o 2) accanto a un testo scritto con i blocchi di Gutenberg (titolo, paragrafi, pulsanti).",
	"category": "starter",
	"icon": "align-pull-left",
	"keywords": [
		"testo",
		"foto",
		"affiancata",
		"split"
	],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [
			"full"
		],
		"anchor": true,
		"customClassName": true,
		"html": false,
		"jsx": true
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
