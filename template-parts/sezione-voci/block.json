{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/sezione-voci",
	"title": "Sezione voci",
	"description": "Titolo e un elenco di voci: numerato, a card, a icone o a passi.",
	"category": "starter",
	"icon": "list-view",
	"keywords": [ "servizi", "perché", "voci", "card" ],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [ "full" ],
		"anchor": true,
		"customClassName": true
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
