{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/slider",
	"title": "Slider",
	"description": "Slider singolo o carosello di immagini: quante vedere per dispositivo, anteprima delle vicine, distanza, frecce, paginazione e autoplay.",
	"category": "starter",
	"icon": "images-alt2",
	"keywords": [ "slider", "carosello", "gallery", "immagini", "galleria" ],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [ "full" ],
		"anchor": true,
		"customClassName": true
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
