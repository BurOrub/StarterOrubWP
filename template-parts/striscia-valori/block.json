{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/striscia-valori",
	"title": "Striscia valori",
	"description": "Riga di voci con icona e titolo (es. garanzia, spedizione, assistenza).",
	"category": "starter",
	"icon": "editor-ul",
	"keywords": [
		"valori",
		"icone",
		"vantaggi"
	],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [
			"full"
		],
		"anchor": true,
		"customClassName": true,
		"html": false
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
