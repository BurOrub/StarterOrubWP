{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/team",
	"title": "Team",
	"description": "Griglia delle persone del team: foto quadrata, nome, ruolo e breve bio.",
	"category": "starter",
	"icon": "groups",
	"keywords": [
		"team",
		"persone",
		"staff"
	],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [
			"full"
		],
		"anchor": true,
		"customClassName": true,
		"html": false
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
