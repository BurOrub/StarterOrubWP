{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter-theme/testo-affiancato",
	"title": "Testo affiancato",
	"description": "Testo e fino a 2 foto composte, affiancati.",
	"category": "starter",
	"icon": "align-pull-left",
	"keywords": [ "testo", "foto", "chi siamo" ],
	"acf": {
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": [ "full" ],
		"anchor": true,
		"customClassName": true
	},
	"textdomain": "slug-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	}
}
